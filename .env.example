# ==============================================================================
# Wellstar Bright School Management System - Environment Configuration
# ==============================================================================
# For local development: Copy this file to .env and set your credentials.
# For Vercel deployment: Add these variables under Project Settings > Environment Variables.

# PostgreSQL Connection URL (Neon, Supabase, AWS RDS, etc.)
# Format: postgresql://[user]:[password]@[host]/[dbname]?sslmode=require
DATABASE_URL="postgresql://username:password@ep-your-db-host.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Canonical Site URL (for SEO, sitemap.xml, robots.txt, and OpenGraph)
NEXT_PUBLIC_SITE_URL="https://wellstarbrightss.vercel.app"

# Meta (Facebook) Pixel ID for ad conversion tracking and retargeting
NEXT_PUBLIC_FACEBOOK_PIXEL_ID="1148817633288421"
